    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2024-07-12-regulation-adopted",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2024-07-12-regulation-adopted",
      "dct:date": {
        "@value": "2024-07-12",
        "@type": "xsd:date"
      },
      "regula:eventType": "regulation-adoption",
      "dct:description": "The EU AI Act is published in the Official Journal of the European Union. Regulation (EU) 2024/1689 enters into force 20 days later (1 August 2024). Subsequent application dates are staggered: Article 5 prohibitions from 2 February 2025, General-Purpose AI rules from 2 August 2025, governance and penalty provisions from 2 August 2025, high-risk system obligations from 2 August 2026, and high-risk systems placed on the market before 2 August 2026 from 2 August 2027 (per Article 113).",
      "dct:source": {
        "@id": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32024R1689"
      },
      "regula:sourceTitle": "Regulation (EU) 2024/1689 of the European Parliament and of the Council of 13 June 2024 laying down harmonised rules on artificial intelligence",
      "regula:affectedArticles": [
        "*"
      ],
      "regula:confidence": "verified-primary",
      "regula:jurisdiction": "EU",
      "dct:subject": {
        "@id": "http://data.europa.eu/eli/reg/2024/1689/oj"
      },
      "regula:celexNumber": "32024R1689",
      "regula:verifiedOn": {
        "@value": "2026-04-09",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "Regula project",
      "regula:mechanicalChange": "Adoption and publication of the full regulation text. Establishes risk-based categorisation (prohibited, high-risk, limited-risk, minimal-risk), obligations for providers and deployers, conformity assessment procedures, post-market monitoring, and penalties up to EUR 35 million or 7% of global annual turnover."
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2025-11-19-digital-omnibus-proposal",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2025-11-19-digital-omnibus-proposal",
      "dct:date": {
        "@value": "2025-11-19",
        "@type": "xsd:date"
      },
      "regula:eventType": "amendment-proposal",
      "dct:description": "The European Commission publishes the Digital Omnibus on AI: a targeted simplification package proposing to defer the application dates for high-risk AI system obligations and to clarify transparency duties. The proposal shifts the Annex III high-risk deadline from 2 August 2026 to a later date (widely reported as 2 December 2027 in the proposal text), with further deferrals for systems placed on the market before the new application date. Procedural simplifications are proposed for SMEs and for conformity assessment steps.",
      "dct:source": {
        "@id": "https://digital-strategy.ec.europa.eu/en/library/digital-omnibus-ai-simplification-package"
      },
      "regula:sourceTitle": "Digital Omnibus on AI — European Commission proposal for targeted amendments to Regulation (EU) 2024/1689",
      "regula:affectedArticles": [
        "6",
        "13",
        "26",
        "43",
        "50",
        "113"
      ],
      "regula:confidence": "verified-primary",
      "regula:jurisdiction": "EU",
      "regula:verifiedOn": {
        "@value": "2026-04-09",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "Regula project",
      "regula:mechanicalChange": "Proposed deferral: Annex III high-risk obligations from 2 August 2026 → 2 December 2027. Annex I high-risk systems: deferred into 2028. Proposed clarifications to Article 6(3) on narrow procedural tasks and to Article 50 transparency thresholds. Not yet adopted — requires Council + Parliament agreement through the ordinary legislative procedure."
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-03-13-council-position",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2026-03-13-council-position",
      "dct:date": {
        "@value": "2026-03-13",
        "@type": "xsd:date"
      },
      "regula:eventType": "council-position",
      "dct:description": "The Council of the European Union adopts its general approach on the Digital Omnibus on AI. Member State representatives agree on a negotiating position that broadly endorses the Commission proposal's deferral of high-risk AI system obligations, with targeted amendments on the scope of Article 6(3) and on Member State sandbox establishment timelines. The general approach opens the door to trilogue negotiations with the European Parliament.",
      "dct:source": {
        "@id": "https://www.consilium.europa.eu/en/press/press-releases/"
      },
      "regula:sourceTitle": "Council of the EU — general approach on the Digital Omnibus on AI",
      "regula:affectedArticles": [
        "6",
        "13",
        "26",
        "43",
        "50",
        "113"
      ],
      "regula:confidence": "reported-unverified",
      "regula:jurisdiction": "EU",
      "regula:verifiedOn": {
        "@value": "2026-04-09",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "Regula project — primary source URL is a Council press release aggregator; the specific press release for this file needs to be identified and linked before this entry is promoted to verified-primary",
      "regula:mechanicalChange": "Council general approach locked in. Negotiating mandate extends the Commission's deferral proposal and adds clarifications on regulatory sandbox timelines (Article 57) and on the classification of narrow procedural tasks (Article 6(3)). No direct amendments to Articles 9-15 obligations themselves."
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-03-26-parliament-position",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2026-03-26-parliament-position",
      "dct:date": {
        "@value": "2026-03-26",
        "@type": "xsd:date"
      },
      "regula:eventType": "parliament-position",
      "dct:description": "The European Parliament adopts its first-reading position on the Digital Omnibus on AI. The vote establishes Parliament's negotiating mandate for trilogue. Parliament's position broadly supports the deferral but introduces amendments strengthening transparency requirements (Article 50) and narrowing the Article 6(3) narrow-procedural-task carve-out.",
      "dct:source": {
        "@id": "https://www.europarl.europa.eu/news/en/press-room"
      },
      "regula:sourceTitle": "European Parliament — position on the Digital Omnibus on AI (first reading)",
      "regula:affectedArticles": [
        "6",
        "13",
        "26",
        "43",
        "50",
        "113"
      ],
      "regula:confidence": "reported-unverified",
      "regula:jurisdiction": "EU",
      "regula:verifiedOn": {
        "@value": "2026-04-09",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "Regula project — press release URL needs to be identified and linked before this entry is promoted",
      "regula:mechanicalChange": "Parliament position locked in. Amendments tabled on Article 50 transparency thresholds and Article 6(3) scope. No direct amendments to the core high-risk obligation articles (9-15)."
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-04-28-trilogue-target",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2026-04-28-trilogue-target",
      "dct:date": {
        "@value": "2026-04-28",
        "@type": "xsd:date"
      },
      "regula:eventType": "amendment-proposal",
      "dct:description": "Target date for the first trilogue meeting between Council, Parliament and Commission on the Digital Omnibus on AI. Not an adopted change — this entry tracks the calendar milestone so the Regula countdown and the FAQ copy can reflect the live state of negotiations. Once the trilogue outcome is known, this entry will be superseded by a `trilogue-outcome` entry with the specific compromise text.",
      "dct:source": {
        "@id": "https://digital-strategy.ec.europa.eu/en/policies/regulatory-framework-ai"
      },
      "regula:sourceTitle": "Trilogue negotiations — Digital Omnibus on AI (target date)",
      "regula:affectedArticles": [
        "6",
        "13",
        "26",
        "43",
        "50",
        "113"
      ],
      "regula:confidence": "reported-unverified",
      "regula:jurisdiction": "EU",
      "regula:verifiedOn": {
        "@value": "2026-04-09",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "Regula project — calendar milestone from legal-firm reporting; official confirmation pending",
      "regula:mechanicalChange": "No change yet — placeholder for the negotiation milestone."
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-04-29-trilogue-failed",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2026-04-29-trilogue-failed",
      "dct:date": {
        "@value": "2026-04-29",
        "@type": "xsd:date"
      },
      "regula:eventType": "amendment-proposal",
      "dct:description": "The first political trilogue on the Digital Omnibus on AI ended without agreement on 29 April 2026 after approximately 12 hours of negotiations. The sticking point was the conformity-assessment architecture for AI in regulated products under Annex I: Parliament pushed to move sectoral legislation (machinery, medical devices, toys) from Section A to Section B, effectively letting sectoral safety law handle those AI systems; the Council resisted, wanting to preserve AI Act oversight for sensitive sectors. A follow-up trilogue is scheduled for approximately 13 May 2026. The Cypriot Council Presidency must close the file before its term ends 30 June 2026; otherwise the Lithuanian Presidency takes over from 1 July. If the Omnibus is not formally adopted before 2 August 2026, the original AI Act obligations (Regulation 2024/1689, Article 113) apply as written on that date. Multiple advisory firms (IAPP, DLA Piper, Modulos) now recommend organisations prepare against the original 2 August 2026 deadline rather than relying on the proposed extensions.",
      "dct:source": {
        "@id": "https://iapp.org/news/a/ai-act-omnibus-what-just-happened-and-what-comes-next"
      },
      "regula:sourceTitle": "AI Act Omnibus: first political trilogue ends without agreement",
      "regula:affectedArticles": [
        "6",
        "13",
        "26",
        "43",
        "50",
        "113"
      ],
      "regula:confidence": "verified-primary",
      "regula:jurisdiction": "EU",
      "regula:verifiedOn": {
        "@value": "2026-05-01",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "IAPP, Modulos, The Next Web, Computerworld, Ropes & Gray — multiple independent legal and policy sources confirmed the trilogue outcome",
      "regula:mechanicalChange": "No change to the AI Act text. The proposed delay (2 Dec 2027 for standalone Annex III, 2 Aug 2028 for Annex I products) remains a proposal, not law. Original deadlines remain legally binding.",
      "regula:supersedes": {
        "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-04-28-trilogue-target"
      }
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-05-07-trilogue-agreement",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2026-05-07-trilogue-agreement",
      "dct:date": {
        "@value": "2026-05-07",
        "@type": "xsd:date"
      },
      "regula:eventType": "trilogue-outcome",
      "dct:description": "The follow-up political trilogue on the Digital Omnibus on AI succeeded on 7 May 2026, reaching a provisional agreement between the Council and the European Parliament after the 28-29 April round had ended without agreement. The agreement defers the application of obligations for standalone high-risk AI systems under Annex III from 2 August 2026 to 2 December 2027, and for high-risk AI embedded in regulated products under Annex I to 2 August 2028. It also introduces new prohibitions (non-consensual intimate deepfakes / CSAM) applying from 2 December 2026 and moves the Article 50(2) synthetic-content marking transition to 2 December 2026. The provisional agreement was approved by Member States' ambassadors (Coreper) on 13 May 2026.",
      "dct:source": {
        "@id": "https://www.consilium.europa.eu/en/press/press-releases/2026/05/07/artificial-intelligence-council-and-parliament-agree-to-simplify-and-streamline-rules/"
      },
      "regula:sourceTitle": "Artificial intelligence: Council and Parliament agree to simplify and streamline rules",
      "regula:affectedArticles": [
        "6",
        "50",
        "51",
        "57",
        "113"
      ],
      "regula:confidence": "verified-primary",
      "regula:jurisdiction": "EU",
      "regula:verifiedOn": {
        "@value": "2026-07-22",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "Council of the EU press release (7 May 2026); European Parliament press release 20260427IPR42011; corroborated by White & Case, Inside Privacy, IAPP",
      "regula:mechanicalChange": "Still a proposal at this stage: the provisional agreement changes no AI Act text until it is formally adopted by both institutions and published in the Official Journal. Original deadlines (including 2 August 2026 for Annex III) remained legally binding as at this date.",
      "regula:supersedes": {
        "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-04-29-trilogue-failed"
      }
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-06-16-parliament-adoption",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2026-06-16-parliament-adoption",
      "dct:date": {
        "@value": "2026-06-16",
        "@type": "xsd:date"
      },
      "regula:eventType": "parliament-position",
      "dct:description": "The European Parliament's plenary approved the Digital Omnibus on AI on 16 June 2026 by 423 votes to 57, with 174 abstentions, endorsing the 7 May provisional agreement. This confirms Parliament's side of the deferral of Annex III high-risk obligations to 2 December 2027 and Annex I product-embedded obligations to 2 August 2028, and the new prohibition on non-consensual intimate deepfakes. The IMCO and LIBE committees had approved the agreed text on 2 June 2026. Formal adoption still required the Council's final approval.",
      "dct:source": {
        "@id": "https://www.europarl.europa.eu/news/en/press-room/20260611IPR45207/ai-act-ep-approves-simplification-measures-and-nudifier-app-ban"
      },
      "regula:sourceTitle": "AI Act: EP approves simplification measures and \"nudifier\" app ban",
      "regula:affectedArticles": [
        "6",
        "50",
        "51",
        "57",
        "113"
      ],
      "regula:confidence": "verified-primary",
      "regula:jurisdiction": "EU",
      "regula:verifiedOn": {
        "@value": "2026-07-22",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "European Parliament press release 20260611IPR45207 (16 June 2026); European Parliament Legislative Train Schedule (updated 20 June 2026)",
      "regula:mechanicalChange": "No change to the AI Act text yet: Parliament's approval is one of the two co-legislator adoption steps. The amendment does not take legal effect until the Council also adopts it and the act is published in the Official Journal. Original deadlines remained binding as at this date.",
      "regula:supersedes": {
        "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-05-07-trilogue-agreement"
      }
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-06-29-council-adoption",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2026-06-29-council-adoption",
      "dct:date": {
        "@value": "2026-06-29",
        "@type": "xsd:date"
      },
      "regula:eventType": "council-position",
      "dct:description": "The Council of the EU gave its final approval to the Digital Omnibus on AI on 29 June 2026, completing the co-legislators' formal adoption after the European Parliament's 16 June plenary vote. This locks in the deferral of Annex III standalone high-risk obligations from 2 August 2026 to 2 December 2027, and Annex I product-embedded high-risk obligations to 2 August 2028, together with the new prohibitions and the Article 50(2) transition to 2 December 2026. The only remaining step is publication in the Official Journal of the European Union; the act enters into force on the third day after publication.",
      "dct:source": {
        "@id": "https://www.consilium.europa.eu/en/press/press-releases/2026/06/29/artificial-intelligence-council-gives-final-green-light-to-simplify-and-streamline-rules/"
      },
      "regula:sourceTitle": "Artificial intelligence: Council gives final green light to simplify and streamline rules",
      "regula:affectedArticles": [
        "6",
        "50",
        "51",
        "57",
        "113"
      ],
      "regula:confidence": "verified-primary",
      "regula:jurisdiction": "EU",
      "regula:verifiedOn": {
        "@value": "2026-07-22",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "Council of the EU press release (29 June 2026); European Parliament Legislative Train Schedule",
      "regula:mechanicalChange": "The amendment is now adopted by both co-legislators but is not yet in force: it takes legal effect three days after Official Journal publication, which is pending (expected before 2 August 2026). Until publication, the original 2 August 2026 deadline for Annex III high-risk obligations technically remains binding, though the deferral is now settled in substance.",
      "regula:supersedes": {
        "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-06-16-parliament-adoption"
      }
    },
    {
      "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-07-24-oj-publication",
      "@type": "regula:RegulatoryDeltaEvent",
      "dct:identifier": "2026-07-24-oj-publication",
      "dct:date": {
        "@value": "2026-07-24",
        "@type": "xsd:date"
      },
      "regula:eventType": "regulation-adoption",
      "dct:description": "The Digital Omnibus on AI was published in the Official Journal of the European Union on 24 July 2026 as Regulation (EU) 2026/1744, amending Regulation (EU) 2024/1689 (the AI Act) together with Regulation (EU) 2018/1139 (civil aviation) and Regulation (EU) 2023/1230 (machinery). It enters into force on 27 July 2026, the third day following publication. From that date the deferred deadlines are enacted law: Annex III standalone high-risk obligations apply from 2 December 2027, Annex I product-embedded high-risk obligations from 2 August 2028, Article 50(2) watermarking for existing systems from 2 December 2026, and the new Article 5 prohibition on AI-generated CSAM and non-consensual intimate imagery from 2 December 2026. Article 50 transparency duties for new systems keep their 2 August 2026 date, unchanged.",
      "dct:source": {
        "@id": "https://eur-lex.europa.eu/eli/reg/2026/1744/oj"
      },
      "regula:sourceTitle": "Regulation (EU) 2026/1744 of the European Parliament and of the Council of 8 July 2026 (Digital Omnibus on AI)",
      "regula:affectedArticles": [
        "5",
        "6",
        "50",
        "113"
      ],
      "regula:confidence": "verified-primary",
      "regula:jurisdiction": "EU",
      "dct:subject": {
        "@id": "http://data.europa.eu/eli/reg/2026/1744/oj"
      },
      "regula:celexNumber": "32026R1744",
      "regula:verifiedOn": {
        "@value": "2026-07-27",
        "@type": "xsd:date"
      },
      "regula:verifiedBy": "EUR-Lex ELI record retrieved 2026-07-27 (automated fetch of eur-lex.europa.eu/eli/reg/2026/1744/oj/eng returned the regulation text): confirms Regulation (EU) 2026/1744 of 8 July 2026, OJ 24 July 2026, entry into force on the third day following publication (recital 46), Annex III deferral to 2 December 2027 and Annex I deferral to 2 August 2028 (recital 40, quoted), new Article 5 points (ba)/(bb) prohibitions, amended Article 11(1) SME/SMC simplified documentation, and the four-month marking transitional period for providers on the market before 2 August 2026 (recital 38). Previously corroborated by two independent specialised legal publishers (EU Law Live, 24 Jul 2026; NicFab). The retrieval was automated; a maintainer eyeball of the EUR-Lex page remains a cheap extra assurance step.",
      "regula:mechanicalChange": "Regula's OMNIBUS_OJ_DATE flipped to 2026-07-24, deriving the in-force date 2026-07-27. Applicable deadlines in reports, registration packets, explanations and timelines now carry the deferred dates as current law, with the pre-Omnibus dates kept as history and all in-force wording date-qualified (\"in force from 2026-07-27\") so nothing overstated legal status during the three days between publication and effect.",
      "regula:supersedes": {
        "@id": "https://getregula.com/regulations/delta-log/dataset/event/2026-06-29-council-adoption"
      }
    }
  ]
}
